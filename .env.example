# Create with: python -c "import secrets,base64; print('MASTER_KEY='+base64.b64encode(secrets.token_bytes(32)).decode()); print('SESSION_SECRET='+secrets.token_urlsafe(48))"
MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DB_PATH=/app/data/lhm-ads.sqlite3
COOKIE_SECURE=true
META_GRAPH_VERSION=v24.0
GOOGLE_ADS_DEVELOPER_TOKEN=
# Telegram is optional, and is NEVER exposed to the AI or browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional LLM-powered analytical chat (without this key, rules-based reporting is used)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Browser MCP clients with Origin headers must match exact trusted origins; blank denies browser-origin requests.
MCP_ALLOWED_ORIGINS=
