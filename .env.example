# Create with: python -c "import secrets,base64; print('MASTER_KEY='+base64.b64encode(secrets.token_bytes(32)).decode()); print('SESSION_SECRET='+secrets.token_urlsafe(48))"
MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DB_PATH=/app/data/lhm-ads.sqlite3
COOKIE_SECURE=true
META_GRAPH_VERSION=v24.0
GOOGLE_ADS_DEVELOPER_TOKEN=
# Telegram is optional, and is NEVER exposed to the AI or browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MCP is local stdio only and opt-in per admin; no remote MCP token in this shared env.
# Optional Web Push (HTTPS required, key generated OFFLINE, file mounted read-only).
LHM_VAPID_PRIVATE_KEY_FILE=/run/secrets/lhm/vapid.pem
LHM_VAPID_PUBLIC_KEY=
LHM_VAPID_SUBJECT=mailto:support@example.com
# Report analysis runs locally unless an admin separately enables OpenRouter.

# LHM production web/PWA hostname. Set an exact HTTPS origin, no path/query:
PUBLIC_BASE_URL=https://ads.lhmcrm.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
META_APP_ID=
META_APP_SECRET=
META_OAUTH_SCOPES=ads_read
